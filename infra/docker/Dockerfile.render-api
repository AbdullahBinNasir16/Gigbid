# Render (free, 512 MB): API + built web app, lite runtime (same models via ONNX Runtime).
FROM node:22-alpine AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
RUN npx vite build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/app/.hf MALLOC_ARENA_MAX=2 \
    EMBED_BACKEND=onnx ONNX_THREADS=1 MAX_CONCURRENT_RUNS=1 MCP_TRANSPORT=memory \
    MODEL_PROFILE=open_hosted APP_ENV=production SEED_ON_START=1
WORKDIR /app
COPY requirements-render.txt .
RUN pip install --no-cache-dir -r requirements-render.txt
COPY . .
COPY --from=web /web/dist /app/apps/web/dist
RUN mkdir -p data/processed && python -c "from rag.index.store import warm; warm()"
EXPOSE 10000
CMD ["sh", "-c", "uvicorn apps.api.main:app --host 0.0.0.0 --port ${PORT:-10000}"]

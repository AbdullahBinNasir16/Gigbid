# GigSim: student built marketplace simulator. Independent of the agent code.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GIGSIM_DATA_DIR=/app/data \
    GIGSIM_STATE_FILE=/state/gigsim_state.json

WORKDIR /app
COPY gigsim/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt
COPY gigsim /app/gigsim
RUN mkdir -p /state

EXPOSE 8081
CMD ["uvicorn", "gigsim.app:app", "--host", "0.0.0.0", "--port", "8081"]

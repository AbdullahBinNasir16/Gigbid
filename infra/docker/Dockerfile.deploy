# Single-container deployment (Hugging Face Spaces, Docker SDK, port 7860):
# GigSim + API + built web app; MCP servers run in-process (MCP_TRANSPORT=memory);
# LLM calls go to a hosted open-model provider (MODEL_PROFILE=open_hosted, key from secrets).
FROM node:22-alpine AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
RUN npx vite build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/app/.hf \
    MODEL_PROFILE=open_hosted MCP_TRANSPORT=memory GIGSIM_BASE_URL=http://127.0.0.1:8081 \
    GIGSIM_STATE_FILE=/app/data/processed/gigsim_state.json PORT=7860 MAX_CONCURRENT_RUNS=2 \
    SEED_ON_START=1 APP_ENV=production
RUN useradd -m -u 1000 app
WORKDIR /app
RUN pip install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu
COPY --chown=app . .
RUN pip install --no-cache-dir . && mkdir -p data/processed && chown -R app /app
COPY --from=web --chown=app /web/dist /app/apps/web/dist
USER app
RUN python -c "from rag.index.store import warm; warm()"
EXPOSE 7860
CMD ["sh", "infra/docker/start_single.sh"]

# Render (free): the GigSim marketplace simulator as its own service.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MALLOC_ARENA_MAX=2
WORKDIR /app
COPY gigsim/requirements.txt gigsim/requirements.txt
RUN pip install --no-cache-dir -r gigsim/requirements.txt
COPY gigsim gigsim
COPY data/real data/real
EXPOSE 10000
CMD ["sh", "-c", "uvicorn gigsim.app:app --host 0.0.0.0 --port ${PORT:-10000}"]

{
 "marketplace.create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "amount": {
     "exclusiveMinimum": 0,
     "maximum": 1000000,
     "title": "Amount",
     "type": "number"
    },
    "budget_type": {
     "enum": [
      "fixed",
      "hourly"
     ],
     "title": "Budget Type",
     "type": "string"
    },
    "cover_letter": {
     "maxLength": 10000,
     "minLength": 50,
     "title": "Cover Letter",
     "type": "string"
    },
    "dry_run": {
     "default": true,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "maxLength": 200,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9._:\\-]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "maxLength": 128,
     "minLength": 1,
     "title": "Job Id",
     "type": "string"
    },
    "screening_answers": {
     "default": [],
     "items": {
      "type": "string"
     },
     "maxItems": 10,
     "title": "Screening Answers",
     "type": "array"
    },
    "trace_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Trace Id"
    }
   },
   "required": [
    "job_id",
    "cover_letter",
    "amount",
    "budget_type",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "description": "Result of any write. With dry_run=True nothing happened and `preview` says what would.",
   "properties": {
    "connects_balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Balance After"
    },
    "connects_cost": {
     "default": 0,
     "title": "Connects Cost",
     "type": "integer"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "title": "Idempotency Key",
     "type": "string"
    },
    "ok": {
     "title": "Ok",
     "type": "boolean"
    },
    "preview": {
     "additionalProperties": true,
     "title": "Preview",
     "type": "object"
    },
    "replayed": {
     "default": false,
     "title": "Replayed",
     "type": "boolean"
    },
    "resource_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Resource Id"
    }
   },
   "required": [
    "ok",
    "dry_run",
    "idempotency_key"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 },
 "marketplace.get_client_history": {
  "annotations": {

     "title": "Rating"
    },
    "reviews": {
     "items": {
      "type": "string"
     },
     "title": "Reviews",
     "type": "array"
    },
    "total_spend": {
     "default": 0,
     "minimum": 0,
     "title": "Total Spend",
     "type": "number"
    }
   },
   "required": [
    "client_id",
    "completed_projects",
    "payment_verified"
   ],
   "title": "ClientHistory",
   "type": "object"
  }
 },
